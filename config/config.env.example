# Copy this file to config/config.env on the Pi and fill it in.
# config.env is in .gitignore, so these values never go to GitHub.
# Variables starting with SECRET_ are only used on the Pi and are hidden from the browser.

# ── Google Calendar: "Secret address in iCal format" for each calendar ──
# Google Calendar on a computer → Settings → pick the calendar → "Integrate calendar"
# → copy "Secret address in iCal format" (ends in /basic.ics).
SECRET_CAL_FAMILY=https://calendar.google.com/calendar/ical/REPLACE/private-REPLACE/basic.ics
SECRET_CAL_PERSON1=https://calendar.google.com/calendar/ical/REPLACE/private-REPLACE/basic.ics
SECRET_CAL_PERSON2=https://calendar.google.com/calendar/ical/REPLACE/private-REPLACE/basic.ics

# ── Todoist: Settings → Integrations → Developer → API token ──
SECRET_TODOIST_TOKEN=REPLACE

# ── Anthropic API key for the news summary (console.anthropic.com → API keys) ──
# Leave as REPLACE to get plain headlines instead of an AI summary.
SECRET_ANTHROPIC_API_KEY=REPLACE
